# Frontend muhit o'zgaruvchilari namunasi.
# Nusxa oling: cp .env.example .env  va qiymatlarni to'ldiring.

# ── Backend API ──
# Django backend manzili + /api/v1 prefiks (oxirida / QO'YILMAYDI — kod o'zi qo'shadi)
VITE_API_URL=http://localhost:8000/api/v1

# ── Gemini AI (AIChat / AdminTopics uchun) ──
# Kalit oling: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-1.5-flash
